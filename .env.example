# ═════════════════════════════════════════════════════════════════════
#  KaorCount — variáveis de DESENVOLVIMENTO (template)
#
#  Copie para .env  →  cp .env.example .env
#
#  ⚠️  ESTE ARQUIVO NÃO DEVE CONTER SEGREDOS.
#
#  Ele é versionado no Git. Além disso, o Expo embute no bundle do
#  navegador toda variável que começa com EXPO_PUBLIC_ — ou seja, o
#  conteúdo delas fica PÚBLICO para qualquer pessoa que abra o DevTools.
#
#  Para segredos (senhas, chaves), use um destes:
#    • .env        → desenvolvimento local (não entra no Git)
#    • .env.prod   → produção            (não entra no Git)
#    • backend/.env → quando rodar a API fora do Docker
# ═════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
#  FRONTEND — estas vão para o bundle do navegador.
#  Tudo com prefixo EXPO_PUBLIC_ vira texto público no JavaScript.
#  Nunca coloque senha, token ou chave privada aqui.
# ─────────────────────────────────────────────────────────────────────

# URL base da API.
#   - Vazio            = auto-detect (localhost:8000 no web, IP do Expo Go
#                        no celular, 10.0.2.2 no emulador Android).
#   - "/api/v1"        = caminho relativo; o nginx encaminha para a API
#                        (mesma origem, evita CORS). Usado no Docker.
#   - "https://api.exemplo.com/api/v1" = API em outro domínio.
EXPO_PUBLIC_API_URL=

# ═════════════════════════════════════════════════════════════════════
#  BACKEND / COMPOSE — valores de desenvolvimento.
#
#  Estes NÃO são embutidos no bundle (não têm o prefixo EXPO_PUBLIC_),
#  mas ainda assim ficam neste arquivo versionado. Por isso as senhas
#  abaixo são de DESENVOLVIMENTO e não funcionam em produção.
#
#  Em produção, copie .env.prod.example para .env.prod e rode:
#      docker compose --env-file .env.prod -f docker-compose.yml \
#                     -f docker-compose.prod.yml up -d --build
# ═════════════════════════════════════════════════════════════════════

# ── Portas publicadas no host ─────────────────────────────────────
# Altere se já houver algo usando essas portas na sua máquina.
WEB_PORT=8080
API_PORT=8000
DB_PORT=3306

# ── Banco de dados ───────────────────────────────────────────────
DB_NAME=kaorcount
DB_USER=kaorcount
DB_PASSWORD=kaorcount
DB_ROOT_PASSWORD=kaorcount_root

# ── API ─────────────────────────────────────────────────────────
# ⚠️ Em desenvolvimento pode ficar assim. Para gerar uma chave de verdade:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#     e coloque o resultado no .env (não neste arquivo).
SECRET_KEY=chave-insegura-apenas-para-desenvolvimento-local
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1

# ── Integrações externas (opcionais) ─────────────────────────────
# Sem credenciais do FatSecret, apenas a busca de alimentos externos
# fica indisponível — o resto do app continua funcionando.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# ── Modo de execução ─────────────────────────────────────────────
# "development" (padrão): se o MySQL falhar, a API cai para SQLite local.
# "production": a API RECUSA subir sem o MySQL (evita perder dados).
# O docker-compose.prod.yml define ENVIRONMENT=production sozinho —
# não é preciso alterar aqui.
ENVIRONMENT=development

# Domínios liberados no CORS, separados por vírgula.
# Vazio = desenvolvimento libera tudo (como sempre foi).
# Em produção é obrigatório e travado no domínio real.
CORS_ORIGINS=

