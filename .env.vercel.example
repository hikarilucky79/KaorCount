# ═════════════════════════════════════════════════════════════════════
#  KaorCount — backend na Vercel (template)
#
#  Estes valores vão no painel da Vercel:
#      Project → Settings → Environment Variables
#  (não existe .env na Vercel; ela injeta cada variável no processo.)
#
#  O projeto da Vercel usa "Root Directory" = backend, então só a API e a
#  pasta public/ dela sobem. O app Expo (src/) e o Docker ficam de fora.
#
#  ⚠️ A Vercel não alcança o MySQL do seu docker-compose. Ele escuta dentro
#  da rede interna do host. Para a API funcionar lá, DATABASE_URL precisa
#  apontar para um MySQL acessível pela internet (banco gerenciado, ou o
#  MySQL do VPS exposto com firewall). Sem isso a function morre no import,
#  porque ENVIRONMENT=production recusa o fallback para SQLite — e SQLite na
#  Vercel não teria onde escrever de qualquer forma (o sistema de arquivos do
#  function é somente leitura fora de /tmp, e efêmero).
# ═════════════════════════════════════════════════════════════════════

# ── Banco (obrigatório, ver aviso acima) ─────────────────────────────
# Host, porta 3306, usuário com acesso remoto permitido no MySQL.
DATABASE_URL=mysql+pymysql:SEU_USUARIO:SUASENHA@SEU-HOST:3306/kaorcount

# ── JWT ──────────────────────────────────────────────────────────────
# Gere e cole no dashboard. Em produção a API recusa subir com a chave
# padrão do repositório ou com menos de 32 caracteres.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1

# ── Modo de execução ─────────────────────────────────────────────────
# production: sem SQLite silencioso, sem CORS liberado, chave validada.
ENVIRONMENT=production

# ── CORS ─────────────────────────────────────────────────────────────
# Obrigatório em produção. Use o domínio que a Vercel der ao projeto,
# ex.: https://kaorcount-backend.vercel.app — e, se o app web estiver em
# outro lugar, o domínio dele também.
# Dica: se o MESMO projeto servir o app (bundle) e a API, o navegador trata
# como mesma origem e o CORS quase não é exercitado.
CORS_ORIGINS=https://SEU-PRETEXTO.vercel.app

# ── FatSecret (opcional) ─────────────────────────────────────────────
# Sem credenciais a busca de alimentos externos some, o resto funciona.
# São segredos: no painel marque "Sensitive" para não aparecerem no build log.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# ── O que NÃO precisa configurar ─────────────────────────────────────
# CADDY_DOMAIN / ACME_EMAIL / WEB_PORT / API_PORT / DB_PORT / DB_ROOT_PASSWORD:
# são do docker-compose. A Vercel cuida de proxy, HTTPS e domínio sozinha.
#
# EXPO_PUBLIC_API_URL: é do bundle web (Expo), não da API. Se um dia hospedar
# o app Expo na Vercel também, esse valor passa a ser https://SEU-PRETEXTO.vercel.app/api/v1.
