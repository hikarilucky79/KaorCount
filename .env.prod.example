# ═════════════════════════════════════════════════════════════════════
#  KaorCount — configuração de PRODUÇÃO (template)
#
#  Uso:
#    cp .env.prod.example .env.prod
#    # edite os valores abaixo
#    ./run.sh check && ./run.sh prod
#
#  Este arquivo é versionado e NÃO deve receber os valores reais.
#  O .env.prod (a cópia) é ignorado pelo Git e pelo Docker.
#
#  Por que um arquivo separado do .env de desenvolvimento?
#  • Um só arquivo mistura senha de produção com configuração local,
#    e é fácil subir com a senha errada.
#  • O Compose lê este arquivo via --env-file, então nada de produção
#    encosta no seu ambiente de desenvolvimento.
#
#  ⚠️ SEGREDOS: nada aqui começa com EXPO_PUBLIC_ de propósito. Se
#  começo com esse prefixo, o Expo embute o valor no bundle do
#  navegador e ele vira público.
# ═════════════════════════════════════════════════════════════════════

# ── Domínio ────────────────────────────────────────────────────────
# Usado pelo Caddy para emitir o certificado HTTPS. Precisa apontar via DNS
# para o IP do servidor nas portas 80 e 443. Sem isso, o Caddy não sobe.
CADDY_DOMAIN=seudominio.com.br

# E-mail para o Let's Encrypt avisar sobre certificado expirando.
ACME_EMAIL=seu.email@seudominio.com.br

# Domínios liberados no CORS, separados por vírgula.
# Inclua o esquema https:// e o domínio com e sem "www" se ambos forem usados.
# IMPORTANTE: se o bundle web é servido no mesmo domínio (padrão), o CORS
# quase nunca é exercitado — o navegador trata como mesma origem.
CORS_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# ── OBRIGATÓRIO: chave de assinatura do JWT ────────────────────────
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar essa chave invalida todos os tokens já emitidos (todo mundo
# precisará logar de novo). Nunca use o valor de exemplo.
SECRET_KEY=COLOQUE_AQUI_A_CHAVE_GERADA

# ── OBRIGATÓRIO: banco de dados ────────────────────────────────────
# Gere senhas com: python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_NAME=kaorcount
DB_USER=kaorcount
DB_PASSWORD=COLOQUE_AQUI_A_SENHA_DO_BANCO
DB_ROOT_PASSWORD=COLOQUE_AQUI_A_SENHA_DO_ROOT

# ── API ────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1

# ── Bundle web (público) ───────────────────────────────────────────
# Relativo (/api/v1): o bundle fala com o nginx na MESMA origem e o
# nginx repassa para a API. É a opção mais simples e não exige CORS.
#
# Use URL absoluta apenas se a API estiver em OUTRO domínio, ex.:
#   EXPO_PUBLIC_API_URL=https://api.seudominio.com.br/api/v1
# Nesse caso, adicione também esse domínio em CORS_ORIGINS acima.
EXPO_PUBLIC_API_URL=/api/v1

# ── Integrações externas (opcionais) ───────────────────────────────
# Sem credenciais do FatSecret, apenas a busca de alimentos externos
# fica indisponível — o resto do app continua funcionando.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# ═════════════════════════════════════════════════════════════════════
#  Backup do banco — rode periodicamente (ex.: todo dia às 3h)
#
#  crontab -e
#  0 3 * * * cd /caminho/para/KaorCount && \
#    docker compose --env-file .env.prod \
#      -f docker-compose.yml -f docker-compose.prod.yml \
#      exec -T db mysqldump -u root -p"$DB_ROOT_PASSWORD" \
#      --single-transaction kaorcount | gzip > backup-$(date +\%Y-\%m-\%d).sql.gz
# ═════════════════════════════════════════════════════════════════════
