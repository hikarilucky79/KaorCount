# ═════════════════════════════════════════════════════════════════════
#  KaorCount — backend rodando FORA do Docker (template)
#
#  Só é necessário se você rodar a API direto na máquina, sem container:
#      cd backend
#      python -m uvicorn app.main:app --reload --port 8000
#
#  Quando a API roda no Docker, estas variáveis chegam pelo
#  docker-compose.yml e ESTE ARQUIVO É IGNORADO. Por isso ele pode ficar
#  versionado com valores de exemplo.
#
#  Copie para .env dentro de backend/:
#      cp .env.example .env
#  O .env do backend é lido pelo pydantic (env_file=".env" em core/config.py).
# ═════════════════════════════════════════════════════════════════════

# String de conexão. Em desenvolvimento, se o MySQL não responder, a API
# cai sozinha para um SQLite local — não é preciso configurar nada.
DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/kaorcount

# Chave de assinatura do JWT. Gere uma real com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ Em desenvolvimento este valor serve. Em produção, gere um novo —
# quem tiver esta chave consegue forjar token de qualquer usuário.
SECRET_KEY=trocar-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1

# Credenciais do FatSecret (opcional). Sem elas, apenas a busca de
# alimentos externos fica indisponível.
FATSECRET_CLIENT_ID=sua-client-id
FATSECRET_CLIENT_SECRET=seu-client-secret

# ── Modo de execução ─────────────────────────────────────────────
# "development" (padrão): se o MySQL falhar, a API cai para SQLite local.
# "production": a API RECUSA subir sem o MySQL, para não perder dados.
ENVIRONMENT=development

# Domínios liberados no CORS (separados por vírgula).
# Vazio em desenvolvimento = libera tudo.
# Em produção é obrigatório: a API não sobe sem ele.
CORS_ORIGINS=

