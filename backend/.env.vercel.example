# Configure estes valores no painel da Vercel (Settings > Environment Variables).
# Gere uma SECRET_KEY exclusiva com: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=mysql+pymysql://USUARIO:SENHA@HOST:3306/kaorcount
SECRET_KEY=gere-uma-chave-segura-com-pelo-menos-32-caracteres
ENVIRONMENT=production
CORS_ORIGINS=https://seu-dominio.com

# O Resend envia por HTTPS, sem SMTP. Crie a chave em resend.com e verifique
# o domínio do remetente para enviar códigos aos usuários do app.
RESEND_API_KEY=re_sua_chave_do_resend
RESEND_FROM=KaorCount <nao-responda@seu-dominio-verificado.com>
